# ─────────────────────────────────────────────────────────────
# MkhondeChain Environment Configuration
# ─────────────────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=4000

# Database
MONGO_URI=mongodb://localhost:27017/mkhondechain

# JWT Secret — minimum 32 characters, maximum 128
# Generate a new one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=2be752835312a650037afff26d94a1e8faed36995f683250a550ebd051e40c7f760e61b70fd845ff633a470e135c7af41e20b0db26239bd23322bd264bcc1a01

# Africa's Talking (SMS + USSD)
AT_API_KEY=atsk_55c15acdd2ed690521e2e340707529a5737cb5cfcbd004bc015621f1f9f0015408c51839
AT_USERNAME=sandbox
# AT_SHORTCODE=12345  # Uncomment when shortcode is approved

# Payment Provider
# Options: mock_airtel, mock_tnm
# When ready for production, add: airtel, tnm
PAYMENT_PROVIDER=mock_airtel

# Frontend
FRONTEND_URL=http://localhost:5173

# Logging
LOG_LEVEL=info

